generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssignmentSource {
  MANUAL
  DISCORD
  SYSTEM
}

enum RevisionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MediaVisibility {
  PUBLIC
  INTERNAL
}

enum CalendarEventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum WeeklyRecommendation {
  UPRANK
  LOA
  STRIKE
  BLOCKED
  REMOVAL
  NO_ACTION
}

enum ReviewDecision {
  PENDING
  APPLIED
  REJECTED
  CORRECTED
}

enum TeamStrikeStatus {
  ACTIVE
  WAIVED
  EXPIRED
}

enum DiscordRoleJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum DiscordRoleOperation {
  ADD
  REMOVE
}

enum ScheduledJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum StatusSource {
  ERLC
  DISCORD
  ROBLOX
  MANUAL
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
  UNKNOWN
}

model User {
  id                     String                     @id @default(cuid())
  discordId              String?                    @unique
  discordUsername        String?
  discordDisplayName     String?
  discordAvatarUrl       String?
  discordSyncedAt        DateTime?
  email                  String?                    @unique
  name                   String
  avatar                 String?
  robloxName             String?
  robloxDisplayName      String?
  robloxAvatarUrl        String?
  robloxSyncedAt         DateTime?
  robloxUserId           String?                    @unique
  registrationCompleted  Boolean                    @default(false)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  accounts               AuthAccount[]
  staffProfile           StaffProfile?
  ruleAcceptances        RuleAcceptance[]
  tickets                Ticket[]                   @relation("TicketOwner")
  assignedTickets        Ticket[]                   @relation("TicketAssignee")
  ticketMessages         TicketMessage[]
  authoredNews           NewsPost[]
  auditLogs              AuditLog[]
  roleAssignments        UserRoleAssignment[]       @relation("UserRoleAssignments")
  grantedRoleAssignments UserRoleAssignment[]       @relation("RoleAssignmentActor")
  ruleRevisions          RuleRevision[]             @relation("RuleRevisionEditor")
  newsRevisions          NewsRevision[]             @relation("NewsRevisionEditor")
  uploadedMedia          MediaAsset[]               @relation("MediaUploader")
  editedFaqItems         FaqItem[]                  @relation("FaqItemEditor")
  editedStaffFaqItems    StaffFaqItem[]             @relation("StaffFaqItemEditor")
  editedHomepageCards    HomepageRoleCard[]         @relation("HomepageRoleCardEditor")
  statusUpdates          StatusUpdate[]             @relation("StatusUpdateAuthor")
  createdDocuments       InternalDocument[]         @relation("InternalDocumentCreator")
  documentRevisions      InternalDocumentRevision[] @relation("InternalDocumentRevisionEditor")
  createdCalendarEvents  CalendarEvent[]            @relation("CalendarEventCreator")
  calendarRevisions      CalendarEventRevision[]    @relation("CalendarEventRevisionEditor")
  reviewedCalendarItems  CalendarEventRevision[]    @relation("CalendarEventRevisionReviewer")
  melonlyMember          MelonlyMember?
  reviewedTeamResults    TeamWeeklyResult[]         @relation("TeamWeeklyResultReviewer")
  issuedTeamStrikes      TeamStrike[]               @relation("TeamStrikeIssuer")
}

model AuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  profile           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model StaffProfile {
  id           String      @id @default(cuid())
  userId       String?     @unique
  displayName  String
  title        String
  department   String
  bio          String?
  imageId      String?
  displayOrder Int         @default(0)
  visible      Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  image        MediaAsset? @relation("TeamProfileImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model AccessRole {
  id               String                       @id @default(cuid())
  key              String                       @unique
  name             String                       @unique
  description      String?
  color            String                       @default("#d6aa4c")
  priority         Int                          @default(0)
  isSystem         Boolean                      @default(false)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  permissions      RolePermission[]
  assignments      UserRoleAssignment[]
  discordMappings  DiscordRoleMapping[]
  ticketAccesses   RoleTicketCategoryAccess[]
  documentAccesses RoleDocumentCategoryAccess[]
  calendarAccesses RoleCalendarCategoryAccess[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String?
  group       String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  id           String           @id @default(cuid())
  userId       String
  roleId       String
  source       AssignmentSource
  sourceKey    String           @default("")
  assignedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role         AccessRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?            @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, source, sourceKey])
  @@index([userId])
  @@index([roleId])
}

model DiscordRole {
  id            String                   @id @default(cuid())
  guildId       String
  discordRoleId String
  name          String
  color         String?
  position      Int                      @default(0)
  managed       Boolean                  @default(false)
  lastSyncedAt  DateTime                 @default(now())
  mappings      DiscordRoleMapping[]
  teamMappings  DiscordTeamRoleMapping[]
  roleJobs      DiscordRoleJob[]
  teamRank      DiscordTeamRank?          @relation("DiscordTeamRankRole")
  previousRanks DiscordTeamRank[]         @relation("DiscordTeamRankNextRole")
  rankHistoryFrom DiscordRankHistory[]    @relation("DiscordRankHistoryFrom")
  rankHistoryTo   DiscordRankHistory[]    @relation("DiscordRankHistoryTo")

  @@unique([guildId, discordRoleId])
  @@index([guildId, position])
}

model DiscordRoleMapping {
  id            String      @id @default(cuid())
  discordRoleId String
  accessRoleId  String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  discordRole   DiscordRole @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)
  accessRole    AccessRole  @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)

  @@unique([discordRoleId, accessRoleId])
}

model DiscordMemberSnapshot {
  id           String   @id @default(cuid())
  guildId      String
  discordId    String
  username     String
  displayName  String?
  avatarUrl    String?
  roleIds      Json
  lastSyncedAt DateTime @default(now())

  @@unique([guildId, discordId])
  @@index([discordId])
}

model TicketCategory {
  id          String                     @id @default(cuid())
  key         String                     @unique
  label       String
  description String?
  enabled     Boolean                    @default(true)
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  tickets     Ticket[]
  roleAccess  RoleTicketCategoryAccess[]
}

model RoleTicketCategoryAccess {
  id         String         @id @default(cuid())
  roleId     String
  categoryId String
  canView    Boolean        @default(false)
  canReply   Boolean        @default(false)
  canAssign  Boolean        @default(false)
  canStatus  Boolean        @default(false)
  canDelete  Boolean        @default(false)
  role       AccessRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([roleId, categoryId])
}

model Rule {
  id          String           @id @default(cuid())
  slug        String           @unique
  sourceKey   String?          @unique
  sourceUrl   String?
  category    String
  title       String
  order       Int              @default(0)
  version     Int              @default(0)
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  acceptances RuleAcceptance[]
  revisions   RuleRevision[]
}

model RuleRevision {
  id          String              @id @default(cuid())
  ruleId      String
  status      RevisionStatus      @default(DRAFT)
  content     Json
  searchText  String
  editorId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publishedAt DateTime?
  rule        Rule                @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  editor      User?               @relation("RuleRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  media       RuleRevisionMedia[]

  @@index([ruleId, status, publishedAt])
}

model RuleRevisionMedia {
  id         String       @id @default(cuid())
  revisionId String
  mediaId    String
  sortOrder  Int          @default(0)
  caption    String?
  revision   RuleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([revisionId, mediaId])
}

model RuleAcceptance {
  id         String   @id @default(cuid())
  userId     String
  ruleId     String
  version    Int
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule       Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId, version])
}

model NewsPost {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  excerpt     String
  coverLabel  String?
  published   Boolean        @default(false)
  publishedAt DateTime?
  editedAt    DateTime?
  authorId    String?
  thumbnailId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  thumbnail   MediaAsset?    @relation("NewsThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  revisions   NewsRevision[]
}

model NewsRevision {
  id          String              @id @default(cuid())
  newsPostId  String
  status      RevisionStatus      @default(DRAFT)
  content     Json
  searchText  String
  editorId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publishedAt DateTime?
  newsPost    NewsPost            @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  editor      User?               @relation("NewsRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  media       NewsRevisionMedia[]

  @@index([newsPostId, status, publishedAt])
}

model NewsRevisionMedia {
  id         String       @id @default(cuid())
  revisionId String
  mediaId    String
  sortOrder  Int          @default(0)
  caption    String?
  revision   NewsRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([revisionId, mediaId])
}

model MediaAsset {
  id                 String                          @id @default(cuid())
  publicId           String                          @unique
  secureUrl          String
  resourceType       String
  kind               MediaKind
  visibility         MediaVisibility                 @default(PUBLIC)
  deliveryType       String                          @default("upload")
  mimeType           String
  originalName       String
  bytes              Int
  width              Int?
  height             Int?
  duration           Float?
  createdById        String?
  createdAt          DateTime                        @default(now())
  createdBy          User?                           @relation("MediaUploader", fields: [createdById], references: [id], onDelete: SetNull)
  ruleRevisions      RuleRevisionMedia[]
  newsRevisions      NewsRevisionMedia[]
  newsThumbnails     NewsPost[]                      @relation("NewsThumbnail")
  teamImages         StaffProfile[]                  @relation("TeamProfileImage")
  homepageCards      HomepageRoleCard[]              @relation("HomepageRoleCardImage")
  documentRevisions  InternalDocumentRevisionMedia[]
  calendarRevisions  CalendarEventRevisionMedia[]
  calendarCovers     CalendarEventRevision[]         @relation("CalendarEventCover")
  calendarCategories CalendarCategory[]              @relation("CalendarCategoryImage")
}

model Ticket {
  id              String          @id @default(cuid())
  number          Int             @unique
  subject         String
  categoryId      String
  priority        String          @default("NORMAL")
  status          TicketStatus    @default(OPEN)
  userId          String
  assigneeId      String?
  ownerArchivedAt DateTime?
  ownerHiddenAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        TicketCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  user            User            @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee        User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([categoryId, status, updatedAt])
  @@index([userId, ownerHiddenAt, ownerArchivedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@index([actorId, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("Allgemein")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  editorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editor    User?    @relation("FaqItemEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([visible, sortOrder])
  @@index([category, visible, sortOrder])
}

model StaffFaqCategory {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  sortOrder   Int            @default(0)
  visible     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       StaffFaqItem[]

  @@index([visible, sortOrder])
}

model StaffFaqItem {
  id         String           @id @default(cuid())
  categoryId String
  question   String
  answer     String
  searchText String
  sortOrder  Int              @default(0)
  visible    Boolean          @default(true)
  editorId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   StaffFaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  editor     User?            @relation("StaffFaqItemEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([categoryId, visible, sortOrder])
  @@index([updatedAt])
}

model InternalDocumentCategory {
  id          String                       @id @default(cuid())
  slug        String                       @unique
  title       String
  description String?
  sortOrder   Int                          @default(0)
  visible     Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  documents   InternalDocument[]
  roleAccess  RoleDocumentCategoryAccess[]

  @@index([visible, sortOrder])
}

model RoleDocumentCategoryAccess {
  id         String                   @id @default(cuid())
  roleId     String
  categoryId String
  canView    Boolean                  @default(false)
  canCreate  Boolean                  @default(false)
  canEdit    Boolean                  @default(false)
  canManage  Boolean                  @default(false)
  role       AccessRole               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  category   InternalDocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([roleId, categoryId])
  @@index([categoryId])
}

model InternalDocument {
  id         String                     @id @default(cuid())
  categoryId String
  slug       String                     @unique
  title      String
  summary    String?
  creatorId  String?
  archivedAt DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  category   InternalDocumentCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator    User?                      @relation("InternalDocumentCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  revisions  InternalDocumentRevision[]

  @@index([categoryId, archivedAt, updatedAt])
}

model InternalDocumentRevision {
  id         String                          @id @default(cuid())
  documentId String
  version    Int
  content    Json
  searchText String
  editorId   String?
  createdAt  DateTime                        @default(now())
  document   InternalDocument                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor     User?                           @relation("InternalDocumentRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  media      InternalDocumentRevisionMedia[]

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model InternalDocumentRevisionMedia {
  id         String                   @id @default(cuid())
  revisionId String
  mediaId    String
  sortOrder  Int                      @default(0)
  caption    String?
  revision   InternalDocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      MediaAsset               @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([revisionId, mediaId])
}

model CalendarCategory {
  id          String                       @id @default(cuid())
  slug        String                       @unique
  title       String
  description String?
  color       String                       @default("#d6aa4c")
  imageId     String?
  sortOrder   Int                          @default(0)
  visible     Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  image       MediaAsset?                  @relation("CalendarCategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  events      CalendarEvent[]
  roleAccess  RoleCalendarCategoryAccess[]

  @@index([visible, sortOrder])
}

model RoleCalendarCategoryAccess {
  id         String           @id @default(cuid())
  roleId     String
  categoryId String
  canCreate  Boolean          @default(false)
  canPublish Boolean          @default(false)
  canEditOwn Boolean          @default(false)
  canManage  Boolean          @default(false)
  role       AccessRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  category   CalendarCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([roleId, categoryId])
  @@index([categoryId])
}

model CalendarEvent {
  id         String                  @id @default(cuid())
  categoryId String
  slug       String                  @unique
  creatorId  String?
  archivedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  category   CalendarCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator    User?                   @relation("CalendarEventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  revisions  CalendarEventRevision[]

  @@index([categoryId, archivedAt, updatedAt])
}

model CalendarEventRevision {
  id                  String                       @id @default(cuid())
  eventId             String
  status              CalendarEventStatus          @default(DRAFT)
  title               String
  summary             String?
  content             Json
  searchText          String
  location            String?
  externalUrl         String?
  coverImageId        String?
  startsAt            DateTime
  endsAt              DateTime
  allDay              Boolean                      @default(false)
  timeZone            String                       @default("Europe/Berlin")
  recurrenceFrequency RecurrenceFrequency          @default(NONE)
  recurrenceInterval  Int                          @default(1)
  recurrenceUntil     DateTime?
  editorId            String?
  reviewerId          String?
  createdAt           DateTime                     @default(now())
  publishedAt         DateTime?
  reviewedAt          DateTime?
  event               CalendarEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  editor              User?                        @relation("CalendarEventRevisionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  reviewer            User?                        @relation("CalendarEventRevisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  coverImage          MediaAsset?                  @relation("CalendarEventCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  media               CalendarEventRevisionMedia[]

  @@index([eventId, status, publishedAt])
  @@index([status, startsAt, endsAt])
}

model CalendarEventRevisionMedia {
  id         String                @id @default(cuid())
  revisionId String
  mediaId    String
  sortOrder  Int                   @default(0)
  caption    String?
  revision   CalendarEventRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      MediaAsset            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([revisionId, mediaId])
}

model HomepageRoleCard {
  id          String      @id @default(cuid())
  code        String
  title       String
  description String
  imageId     String?
  targetUrl   String?
  linkLabel   String?
  sortOrder   Int         @default(0)
  visible     Boolean     @default(true)
  editorId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  image       MediaAsset? @relation("HomepageRoleCardImage", fields: [imageId], references: [id], onDelete: SetNull)
  editor      User?       @relation("HomepageRoleCardEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([visible, sortOrder])
}

model ErlcServerState {
  id               String    @id @default("primary")
  online           Boolean   @default(false)
  source           String    @default("unavailable")
  name             String    @default("DRP Private Server")
  currentPlayers   Int?
  maxPlayers       Int?
  queueCount       Int?
  staffCount       Int?
  vehicleCount     Int?
  emergencyCount   Int?
  modCallCount     Int?
  currentDetails   Json?
  checkedAt        DateTime?
  lastSuccessfulAt DateTime?
  errorMessage     String?
  leaseUntil       DateTime?
  updatedAt        DateTime  @updatedAt
}

model ErlcMetricSnapshot {
  id             String   @id @default(cuid())
  players        Int      @default(0)
  maxPlayers     Int?
  queueCount     Int      @default(0)
  staffCount     Int      @default(0)
  vehicleCount   Int      @default(0)
  emergencyCount Int      @default(0)
  modCallCount   Int      @default(0)
  capturedAt     DateTime @default(now())

  @@index([capturedAt])
}

model StatusService {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  description   String?
  source        StatusSource
  enabled       Boolean        @default(true)
  sortOrder     Int            @default(0)
  manualStatus  ServiceStatus  @default(OPERATIONAL)
  lastStatus    ServiceStatus  @default(UNKNOWN)
  lastMessage   String?
  lastCheckedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  updates       StatusUpdate[]

  @@index([enabled, sortOrder])
}

model StatusUpdate {
  id        String        @id @default(cuid())
  serviceId String
  status    ServiceStatus
  message   String?
  public    Boolean       @default(true)
  authorId  String?
  createdAt DateTime      @default(now())
  service   StatusService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  author    User?         @relation("StatusUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@index([public, createdAt])
}

model BotRecord {
  id             String    @id @default(cuid())
  namespace      String
  key            String
  discordGuildId String?
  data           Json
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
  @@index([discordGuildId])
}

model BotEvent {
  id             String   @id @default(cuid())
  externalId     String?  @unique
  type           String
  discordGuildId String?
  source         String   @default("discord-bot")
  data           Json
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@index([type, occurredAt])
}

model BotSyncReceipt {
  id         String   @id @default(cuid())
  externalId String   @unique
  kind       String
  createdAt  DateTime @default(now())
}

model MelonlyRole {
  id                  String          @id @default(cuid())
  externalId          String          @unique
  name                String
  position            Int             @default(0)
  weeklyTargetMinutes Int             @default(0)
  nextRoleId          String?
  active              Boolean         @default(true)
  lastSyncedAt        DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  nextRole            MelonlyRole?    @relation("MelonlyRoleProgression", fields: [nextRoleId], references: [id], onDelete: SetNull)
  previousRoles       MelonlyRole[]   @relation("MelonlyRoleProgression")
  members             MelonlyMember[]

  @@index([active, position])
}

model MelonlyMember {
  id              String             @id @default(cuid())
  externalId      String             @unique
  userId          String?            @unique
  discordId       String?
  robloxUserId    String?
  displayName     String
  roleId          String?
  active          Boolean            @default(true)
  joinedAt        DateTime?
  lastSyncedAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  role            MelonlyRole?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  shifts          MelonlyShift[]
  leaves          MelonlyLeave[]
  weeklyResults   TeamWeeklyResult[]
  strikes         TeamStrike[]
  rankBlocks      TeamRankBlock[]
  discordRoleJobs DiscordRoleJob[]
  weeklyEntries   TeamWeeklyEntry[]

  @@index([discordId])
  @@index([robloxUserId])
  @@index([active, roleId])
}

model MelonlyShift {
  id              String        @id @default(cuid())
  externalId      String        @unique
  memberId        String
  startsAt        DateTime
  endsAt          DateTime?
  durationMinutes Int           @default(0)
  lastSyncedAt    DateTime      @default(now())
  member          MelonlyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, startsAt])
}

model MelonlyLeave {
  id           String        @id @default(cuid())
  externalId   String        @unique
  memberId     String
  startsOn     DateTime      @db.Date
  endsOn       DateTime      @db.Date
  status       String
  approved     Boolean       @default(false)
  lastSyncedAt DateTime      @default(now())
  member       MelonlyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, startsOn, endsOn])
  @@index([approved, startsOn, endsOn])
}

model TeamWeeklyReview {
  id             String             @id @default(cuid())
  weekStart      DateTime           @db.Date
  weekEnd        DateTime           @db.Date
  reportText     String?
  sourceSyncedAt DateTime?
  mentionMode    String             @default("CODE")
  generatedAt    DateTime?
  mostActiveMemberId String?
  mostActiveDiscordId String?
  mostActiveDisplayName String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  results        TeamWeeklyResult[]
  entries        TeamWeeklyEntry[]
  signatures     TeamWeeklySignature[]

  @@unique([weekStart, weekEnd])
  @@index([weekStart])
}

model DiscordTeamRank {
  id                  String       @id @default(cuid())
  discordRoleId       String       @unique
  section             String       @default("MODERATION")
  shortName           String
  sortOrder           Int          @default(0)
  weeklyTargetMinutes Int          @default(0)
  nextDiscordRoleId   String?
  outputLabel         String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  discordRole         DiscordRole  @relation("DiscordTeamRankRole", fields: [discordRoleId], references: [id], onDelete: Cascade)
  nextDiscordRole     DiscordRole? @relation("DiscordTeamRankNextRole", fields: [nextDiscordRoleId], references: [id], onDelete: SetNull)

  @@index([active, section, sortOrder])
}

model DiscordRankHistory {
  id             String       @id @default(cuid())
  guildId        String
  discordId      String
  fromRoleId     String?
  toRoleId       String?
  fromLabel      String?
  toLabel        String?
  changedAt      DateTime
  detectedAt     DateTime     @default(now())
  fromRole       DiscordRole? @relation("DiscordRankHistoryFrom", fields: [fromRoleId], references: [id], onDelete: SetNull)
  toRole         DiscordRole? @relation("DiscordRankHistoryTo", fields: [toRoleId], references: [id], onDelete: SetNull)

  @@index([guildId, discordId, changedAt])
  @@index([toRoleId, changedAt])
}

model TeamWeeklyEntry {
  id          String           @id @default(cuid())
  reviewId    String
  memberId    String?
  kind        String
  section     String
  discordId   String?
  displayName String
  fromLabel   String?
  toLabel     String?
  text        String?
  sortOrder   Int              @default(0)
  automatic   Boolean          @default(true)
  included    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  review      TeamWeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  member      MelonlyMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([reviewId, section, sortOrder])
}

model TeamWeeklySignature {
  id          String           @id @default(cuid())
  reviewId    String
  discordId   String
  displayName String
  label       String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  review      TeamWeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model TeamWeeklyResult {
  id                  String               @id @default(cuid())
  reviewId            String
  memberId            String
  requiredMinutes     Int                  @default(0)
  actualMinutes       Int                  @default(0)
  loaDays             Int                  @default(0)
  activeStrikesBefore Int                  @default(0)
  recommendation      WeeklyRecommendation
  decision            ReviewDecision       @default(PENDING)
  reason              String
  notes               String?
  reviewerId          String?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  review              TeamWeeklyReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  member              MelonlyMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewer            User?                @relation("TeamWeeklyResultReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  strike              TeamStrike?

  @@unique([reviewId, memberId])
  @@index([memberId, createdAt])
  @@index([decision, recommendation])
}

model TeamStrike {
  id        String            @id @default(cuid())
  memberId  String
  resultId  String?           @unique
  reason    String
  status    TeamStrikeStatus  @default(ACTIVE)
  issuedAt  DateTime          @default(now())
  expiresAt DateTime
  issuerId  String?
  waivedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  member    MelonlyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  result    TeamWeeklyResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)
  issuer    User?             @relation("TeamStrikeIssuer", fields: [issuerId], references: [id], onDelete: SetNull)
  rankBlock TeamRankBlock?

  @@index([memberId, status, expiresAt])
}

model TeamRankBlock {
  id             String        @id @default(cuid())
  memberId       String
  sourceStrikeId String        @unique
  startsAt       DateTime      @default(now())
  endsAt         DateTime
  liftedAt       DateTime?
  createdAt      DateTime      @default(now())
  member         MelonlyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceStrike   TeamStrike    @relation(fields: [sourceStrikeId], references: [id], onDelete: Cascade)

  @@index([memberId, endsAt, liftedAt])
}

model DiscordTeamRoleMapping {
  id            String       @id @default(cuid())
  key           String       @unique
  discordRoleId String?
  enabled       Boolean      @default(true)
  updatedAt     DateTime     @updatedAt
  discordRole   DiscordRole? @relation(fields: [discordRoleId], references: [id], onDelete: SetNull)
}

model DiscordRoleJob {
  id            String               @id @default(cuid())
  dedupeKey     String               @unique
  memberId      String?
  discordId     String
  discordRoleId String
  operation     DiscordRoleOperation
  status        DiscordRoleJobStatus @default(PENDING)
  attempts      Int                  @default(0)
  availableAt   DateTime             @default(now())
  lockedAt      DateTime?
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  member        MelonlyMember?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  discordRole   DiscordRole          @relation(fields: [discordRoleId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([discordId, createdAt])
}

model ScheduledJobRun {
  id         String             @id @default(cuid())
  runKey     String             @unique
  jobKey     String
  status     ScheduledJobStatus @default(RUNNING)
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  details    Json?
  error      String?

  @@index([jobKey, startedAt])
  @@index([status, startedAt])
}
