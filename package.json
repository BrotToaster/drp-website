{
  "name": "drp-erlc-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "npx --yes netlify-cli@27.1.2 dev",
    "dev:next": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:secrets",
    "db:generate": "prisma generate",
    "db:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action DbSetup",
    "db:apply": "npm run db:setup",
    "db:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action DbStatus",
    "db:migrate": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "jobs:tick": "tsx --env-file=.env scripts/railway-jobs.ts",
    "local:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action Start",
    "local:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action Stop",
    "local:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action Status",
    "db:backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action Backup",
    "db:restore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local.ps1 -Action Restore",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "check:release": "tsx --env-file=.env scripts/check-release.ts",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:maps": "node scripts/update-map-assets.mjs",
    "assets:social": "node scripts/generate-social-card.mjs",
    "db:deploy": "node scripts/db-deploy.mjs",
    "preview:credentials": "node scripts/preview.mjs credentials",
    "preview:init": "node scripts/preview.mjs init",
    "preview:reset": "node scripts/preview.mjs reset",
    "check:preview": "tsx scripts/check-preview.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fullcalendar/react": "^7.0.2",
    "@netlify/database": "^1.1.0",
    "@prisma/client": "^6.10.0",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "cheerio": "^1.0.0-rc.12",
    "exceljs": "^4.4.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "mammoth": "^1.12.1",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "temporal-polyfill": "^1.0.4",
    "tsx": "^4.20.0",
    "zod": "4.6.7",
    "pg": "8.23.1",
    "@tiptap/core": "3.32.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.26",
    "prisma": "^6.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.1",
    "sharp": "$sharp",
    "uuid": "11.1.1"
  }
}
