{
  "name": "drp-erlc-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:netlify": "npx --yes netlify-cli@27.1.2 dev",
    "dev:next": "next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:setup": "npx --yes netlify-cli@27.1.2 database migrations apply",
    "db:apply": "npx --yes netlify-cli@27.1.2 database migrations apply",
    "db:status": "npx --yes netlify-cli@27.1.2 database status",
    "db:migrate": "npx --yes netlify-cli@27.1.2 database migrations new",
    "db:seed": "prisma db seed",
    "jobs:tick": "tsx scripts/railway-jobs.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fullcalendar/react": "^7.0.2",
    "@netlify/database": "^1.1.0",
    "@prisma/client": "^6.10.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "cheerio": "^1.0.0-rc.12",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.1",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3",
    "temporal-polyfill": "^1.0.4",
    "tsx": "^4.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "8.5.26",
    "prisma": "^6.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "8.0.1",
    "sharp": "$sharp"
  }
}
